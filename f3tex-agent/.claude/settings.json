{
  "permissions": {
    "deny": [
      "Edit(data/**)",
      "Bash(rm:*)",
      "Bash(curl:*)",
      "Bash(mail:*)",
      "Bash(sendmail:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          { "type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.py\"" }
        ]
      }
    ]
  }
}
